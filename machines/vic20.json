{
  "machines": [

    {
      "id": "vic20",
      "ui": { "panes": ["tape", "cartridge", "graphics-vic"],
              "graphicsFormats": ["char", "char-mc", "char16", "char16-mc"],
              "screenButtons": [
                { "label": "RUN/STOP + RESTORE", "keys": ["run_stop", "restore"],
                  "tooltip": "Hold RUN/STOP and press RESTORE: the KERNAL's warm start. It stops a running program, resets the screen and I/O, and keeps the program in memory." },
                { "label": "RESTORE", "keys": ["restore"],
                  "tooltip": "RESTORE on its own: an NMI. The KERNAL ignores it unless RUN/STOP is held (or a cartridge is present); programs can catch it through the NMI vector at $0318." } ] },
      "displayName": "Commodore VIC-20",
      "licenseClass": "proprietary",
      "clockHz": 1022727,
      "bus": { "type": "FlatMemoryBus", "name": "system", "addrBits": 16 },
      "cpu": { "type": "6502", "dataBus": "system", "codeBus": "system" },
      "devices": [
        { "type": "inline_color_ram","name": "ColorRAM","baseAddr": "0x9600", "size": 1024 },
        { "type": "6560",           "name": "VIC-I",    "baseAddr": "0x9000", "colorRam": true, "dmaBus": true },
        { "type": "6522",           "name": "VIA1",     "baseAddr": "0x9110" },
        { "type": "6522",           "name": "VIA2",     "baseAddr": "0x9120" },
        { "type": "kbd_vic20",      "name": "Keyboard", "baseAddr": null },
        { "type": "datasette",          "name": "Tape",     "baseAddr": null }
      ],
      "roms": [
        { "label": "char",   "path": "roms/vic20/char.bin",   "size": 4096,
          "overlayAddr": "0x8000", "writable": false },
        { "label": "basic",  "path": "roms/vic20/basic.bin",  "size": 8192,
          "overlayAddr": "0xC000", "writable": false },
        { "label": "kernal", "path": "roms/vic20/kernal.bin", "size": 8192,
          "overlayAddr": "0xE000", "writable": false,
          "intercepts": [
            { "type": "cbm.kernal.fileio", "name": "kernal-fileio",
              "load": "$FFD5", "save": "$FFD8", "path": ".",
              "zeroPage": { "status": "$90", "fnlen": "$B7", "sa": "$B9", "fa": "$BA", "fnadr": "$BB" } }
          ] }
      ],
      "symbolFiles": [ "roms/vic20/kernal.sym", "roms/vic20/basic.sym" ],
      "ramExpansions": [
        { "name": "BLK0", "base": "0x0400", "size": 3072,  "installed": false },
        { "name": "BLK1", "base": "0x2000", "size": 8192,  "installed": false },
        { "name": "BLK2", "base": "0x4000", "size": 8192,  "installed": false },
        { "name": "BLK3", "base": "0x6000", "size": 8192,  "installed": false },
        { "name": "BLK5", "base": "0xA000", "size": 8192,  "installed": false }
      ],
      "ramExpansionSlot": {
        "name": "ram",
        "description": "RAM expansion cartridges: 3K at $0400 (BLK0), 8K blocks at $2000, $4000, $6000 (BLK1-3) and $A000 (BLK5, the cartridge area)",
        "default": "8K",
        "presets": [
          { "name": "3K",  "blocks": ["BLK0"] },
          { "name": "8K",  "blocks": ["BLK1"] },
          { "name": "16K", "blocks": ["BLK1", "BLK2"] },
          { "name": "24K", "blocks": ["BLK1", "BLK2", "BLK3"] },
          { "name": "32K", "blocks": ["BLK1", "BLK2", "BLK3", "BLK5"] },
          { "name": "35K", "blocks": ["BLK0", "BLK1", "BLK2", "BLK3", "BLK5"] } ] },
      "signals": [
        { "name": "irq", "type": "shared",    "sources": ["VIA2"] },
        { "name": "nmi", "type": "sharedNmi", "sources": ["VIA1"] }
      ],
      "tapeWiring": {
        "device": "Tape",
        "sense": "VIA1.pa6",
        "motor": "VIA1.ca2",
        "write": "VIA2.pb3",
        "readPulse": "VIA2.ca1"
      },
      "kbdWiring": {
        "device": "Keyboard",
        "colPort": { "device": "VIA2", "port": "B" },
        "rowPort": { "device": "VIA2", "port": "A" },
        "restore": { "line": "VIA1.ca1", "activeLow": true }
      },
      "joystick": { "lines": [ { "device": "VIA1", "port": "A", "up": 2, "down": 3, "left": 4, "fire": 5 }, { "device": "VIA2", "port": "B", "right": 7 } ] },
      "scheduler": { "type": "step_tick", "frameAccumulator": null }
    },

