{
  "machines": [

    {
      "id": "c64",
      "ui": { "panes": ["tape", "drive", "cartridge", "sidscope", "graphics-vic"],
              "graphicsFormats": ["sprite", "sprite-mc", "char", "char-mc"],
              "screenButtons": [
                { "label": "RUN/STOP + RESTORE", "keys": ["run_stop", "restore"],
                  "tooltip": "Hold RUN/STOP and press RESTORE: the KERNAL's warm start. It stops a running program, resets the screen and I/O, and keeps the program in memory." },
                { "label": "RESTORE", "keys": ["restore"],
                  "tooltip": "RESTORE on its own: an NMI. The KERNAL ignores it unless RUN/STOP is held (or a cartridge is present); programs can catch it through the NMI vector at $0318." } ] },
      "displayName": "Commodore 64",
      "licenseClass": "proprietary",
      "clockHz": 985248,
      "bus": { "type": "FlatMemoryBus", "name": "system", "addrBits": 16, "ramInit": "c64" },
      "openBus": { "from": "0xDE00", "to": "0xDFFF" },
      "cpu": { "type": "6510", "dataBus": "system", "codeBus": "system" },
      "devices": [
        { "type": "c64_pla",          "name": "PLA",      "baseAddr": null,
          "ramData": "system" },
        { "type": "inline_color_ram", "name": "ColorRAM", "baseAddr": "0xD800", "size": 1024 },
        { "type": "6567",             "name": "VIC-II",   "baseAddr": "0xD000",
          "dmaBus": true, "colorRam": true, "options": { "decode": "0x3FF" } },
        { "type": "6581",             "name": "SID",      "baseAddr": "0xD400" },
        { "type": "6526",             "name": "CIA1",     "baseAddr": "0xDC00",
          "clockHz": 985248, "options": { "decode": "0xFF" },
          "portBWriteCallback": "light_pen", "lightPenTarget": "VIC-II" },
        { "type": "6526",             "name": "CIA2",     "baseAddr": "0xDD00",
          "clockHz": 985248, "options": { "decode": "0xFF" },
          "portAWriteCallback": "vic2_bank_select", "bankSelectTarget": "VIC-II" },
        { "type": "kbd_c64",          "name": "Keyboard", "baseAddr": null },
        { "type": "datasette",          "name": "Tape",     "baseAddr": null },
        { "type": "virtual_iec",      "name": "Drive8",   "baseAddr": null }
      ],
      "roms": [
        { "label": "basic",  "path": "roms/c64/basic.bin",  "size": 8192,
          "overlayAddr": null, "writable": false,
          "passToDevice": ["PLA"] },
        { "label": "kernal", "path": "roms/c64/kernal.bin", "size": 8192,
          "overlayAddr": null, "writable": false, "cpuAddr": "0xE000",
          "passToDevice": ["PLA"],
          "intercepts": [
            { "type": "cbm.kernal.fileio", "name": "kernal-fileio",
              "load": "$FFD5", "save": "$FFD8", "path": ".",
              "zeroPage": { "status": "$90", "fnlen": "$B7", "sa": "$B9", "fa": "$BA", "fnadr": "$BB" } }
          ] },
        { "label": "char",   "path": "roms/c64/char.bin",   "size": 4096,
          "overlayAddr": null, "writable": false,
          "passToDevice": ["PLA", "VIC-II"] }
      ],
      "symbolFiles": [ "roms/c64/kernal.sym", "roms/c64/basic.sym" ],
      "signals": [
        { "name": "irq", "type": "shared", "sources": ["VIC-II", "CIA1"], "lines": ["expansion_irq"] },
        { "name": "nmi", "type": "sharedNmi", "sources": ["CIA2"], "lines": ["restore", "expansion_nmi"] }
      ],
      "plaWiring": {
        "device": "PLA",
        "signals": {
          "loram":  "loram",
          "hiram":  "hiram",
          "charen": "charen"
        }
      },
      "tapeWiring": {
        "device": "Tape",
        "sense": "cassette_sense",
        "motor": "cassette_motor",
        "write": "cassette_write",
        "readPulse": "CIA1.flag"
      },
      "joystick": [ { "device": "CIA1", "port": "B" }, { "device": "CIA1", "port": "A" } ],
      "joystickPrimary": 1,
      "kbdWiring": {
        "device": "Keyboard",
        "colPort": { "device": "CIA1", "port": "A" },
        "rowPort": { "device": "CIA1", "port": "B" },
        "restore": { "line": "restore" }
      },
      "iecWiring": {
        "device": "Drive8",
        "busPort": { "device": "CIA2", "port": "A" }
      },
      "expansions": [
        { "name": "port",
          "description": "The expansion port: a RAM expansion beside any cartridge (an REU at $DF00, or a GeoRAM paged through $DE00)",
          "devices": [
            { "id": "reu", "type": "reu", "name": "REU",
              "description": "Commodore REU: 128K (1700), 256K (1764), 512K (1750), or 1M-16M (1750 XL style); or a .reu image file",
              "options": ["128K", "256K", "512K", "1M", "2M", "4M", "8M", "16M"], "default": "512K",
              "optionKey": "size", "irq": "expansion_irq", "busMaster": true },
            { "id": "georam", "type": "georam", "name": "GeoRAM",
              "description": "GeoRAM / NeoRAM: 512K-4M, a 256-byte page at $DE00 ($DFFE page, $DFFF block); or an image file",
              "options": ["512K", "1M", "2M", "4M"], "default": "512K", "optionKey": "size" } ] },
        { "name": "control1",
          "description": "Control port 1: a mouse (the host's mouse moves it)",
          "devices": [
            { "id": "1351", "type": "mouse1351", "name": "1351 Mouse",
              "description": "Commodore 1351 mouse, proportional mode: position on the SID's POTX/POTY, left button = fire, right = up",
              "linkTo": { "device": "SID", "as": "pots" }, "pointer": { "joystickPort": 0 } } ] },
        { "name": "sid2",
          "description": "A second SID (a stereo-SID cartridge or mod), mixed with the first; its address is the option",
          "devices": [
            { "id": "sid", "type": "6581", "name": "SID2",
              "description": "A second 6581 SID: $D420 (the common mod), $D500, $DE00 or $DF00 (cartridges)",
              "options": ["D420", "D500", "DE00", "DF00"], "default": "D420", "optionKey": "base",
              "linkTo": { "device": "SID", "as": "mix" } } ] },
        { "name": "rs232",
          "description": "An RS-232 cartridge on the expansion port (through a port expander, beside a RAM expansion); its far end: CLI serial",
          "devices": [
            { "id": "swiftlink", "type": "swiftlink", "name": "SwiftLink",
              "description": "SwiftLink: a 6551 ACIA with a 3.6864 MHz crystal (up to 38400 bps), interrupting on NMI",
              "options": ["DE00", "DF00", "D700"], "default": "DE00", "optionKey": "base", "irq": "expansion_nmi" },
            { "id": "turbo232", "type": "turbo232", "name": "Turbo232",
              "description": "Turbo232: a SwiftLink with an enhanced control register for 57600, 115200 and 230400 bps",
              "options": ["DE00", "DF00", "D700"], "default": "DE00", "optionKey": "base", "irq": "expansion_nmi" } ] } ],
      "scheduler": { "type": "step_tick", "frameAccumulator": null, "baSource": "VIC-II" }
    }

  ]
}
