{
  "machines": [

    {
      "id": "c64",
      "ui": { "panes": ["tape", "drive", "cartridge", "sidscope", "graphics-vic"],
              "graphicsFormats": ["sprite", "sprite-mc", "char", "char-mc"] },
      "displayName": "Commodore 64",
      "licenseClass": "proprietary",
      "clockHz": 985248,
      "bus": { "type": "FlatMemoryBus", "name": "system", "addrBits": 16 },
      "cpu": { "type": "6510", "dataBus": "system", "codeBus": "system" },
      "devices": [
        { "type": "c64_pla",          "name": "PLA",      "baseAddr": null,
          "ramData": "system" },
        { "type": "inline_color_ram", "name": "ColorRAM", "baseAddr": "0xD800", "size": 1024 },
        { "type": "6567",             "name": "VIC-II",   "baseAddr": "0xD000",
          "dmaBus": true, "colorRam": true },
        { "type": "6581",             "name": "SID",      "baseAddr": "0xD400" },
        { "type": "6526",             "name": "CIA1",     "baseAddr": "0xDC00",
          "clockHz": 985248 },
        { "type": "6526",             "name": "CIA2",     "baseAddr": "0xDD00",
          "clockHz": 985248,
          "portAWriteCallback": "vic2_bank_select", "bankSelectTarget": "VIC-II" },
        { "type": "kbd_c64",          "name": "Keyboard", "baseAddr": null },
        { "type": "datasette",          "name": "Tape",     "baseAddr": null },
        { "type": "virtual_iec",      "name": "Drive8",   "baseAddr": null }
      ],
      "roms": [
        { "label": "basic",  "path": "roms/c64/basic.bin",  "size": 8192,
          "overlayAddr": null, "writable": false,
          "passToDevice": ["PLA"] },
        { "label": "kernal", "path": "roms/c64/kernal.bin", "size": 8192,
          "overlayAddr": null, "writable": false, "cpuAddr": "0xE000",
          "passToDevice": ["PLA"],
          "intercepts": [
            { "type": "cbm.kernal.fileio", "name": "kernal-fileio",
              "load": "$FFD5", "save": "$FFD8", "path": ".",
              "zeroPage": { "status": "$90", "fnlen": "$B7", "sa": "$B9", "fa": "$BA", "fnadr": "$BB" } }
          ] },
        { "label": "char",   "path": "roms/c64/char.bin",   "size": 4096,
          "overlayAddr": null, "writable": false,
          "passToDevice": ["PLA", "VIC-II"] }
      ],
      "symbolFiles": [ "roms/c64/kernal.sym", "roms/c64/basic.sym" ],
      "signals": [
        { "name": "irq", "type": "shared", "sources": ["VIC-II", "CIA1"] },
        { "name": "nmi", "type": "sharedNmi", "sources": ["CIA2"], "lines": ["restore"] }
      ],
      "plaWiring": {
        "device": "PLA",
        "signals": {
          "loram":  "loram",
          "hiram":  "hiram",
          "charen": "charen"
        }
      },
      "tapeWiring": {
        "device": "Tape",
        "sense": "cassette_sense",
        "motor": "cassette_motor",
        "write": "cassette_write",
        "readPulse": "CIA1.flag"
      },
      "joystick": [ { "device": "CIA1", "port": "B" }, { "device": "CIA1", "port": "A" } ],
      "joystickPrimary": 1,
      "kbdWiring": {
        "device": "Keyboard",
        "colPort": { "device": "CIA1", "port": "A" },
        "rowPort": { "device": "CIA1", "port": "B" },
        "restore": { "line": "restore" }
      },
      "iecWiring": {
        "device": "Drive8",
        "busPort": { "device": "CIA2", "port": "A" }
      },
      "scheduler": { "type": "step_tick", "frameAccumulator": null }
    }

  ]
}
